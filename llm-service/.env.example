# llm-service — заполняется в общем .env стека (docker/), это только шаблон.

DATABASE_URL=postgres://llm_app:CHANGE_ME@llm-db:5432/llm?sslmode=disable
PORT=3000

LLM_APP_ID=llm
LLM_APP_NAME=LLM Center
LLM_OWNER_EMAIL=owner@tn.ru
LLM_SERVICE_SECRET=CHANGE_ME_32_BYTE_HEX

# AES-256 ключ шифрования пользовательских API-ключей в БД — 32 байта, base64.
# Сгенерировать: openssl rand -base64 32
LLM_KEY_ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTES

# Провайдер по умолчанию (OpenAI-совместимый Chat Completions); пользователь
# может переопределить свой api_url через POST /api/llm/settings.
LLM_API_URL=https://ask.chadgpt.ru/api/v1/chat/completions
LLM_MODELS_URL=https://ask.chadgpt.ru/api/v1/models

AUTH_SERVICE_URL=http://auth-service:3000
